{
  "name": "manuscript-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:mac:universal": "npm run build && electron-builder --mac --universal",
    "build:win": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/file-saver": "^2.0.7",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "firebase": "^11.3.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "tailwind-merge": "^3.6.0"
  },
  "build": {
    "appId": "com.manuscriptstudio.app",
    "productName": "Manuscript Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "Manuscript-Studio.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Manuscript-Studio.${ext}",
      "signAndEditExecutable": false
    }
  }
}
